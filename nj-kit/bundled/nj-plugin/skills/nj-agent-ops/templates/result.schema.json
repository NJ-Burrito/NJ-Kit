{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "nj-agent-ops worker result",
  "type": "object",
  "required": ["agent", "stage", "status", "files", "gates", "artefacts", "leftovers", "detail_path"],
  "properties": {
    "run_id": { "type": ["string", "null"], "description": "optional; the directory name already carries it" },
    "agent": { "type": "string", "description": "agent name, matches the result filename" },
    "stage": { "type": "string" },
    "status": { "type": "string", "enum": ["ok", "partial", "failed"], "description": "execution status" },
    "failure_class": { "type": ["string", "null"], "enum": ["CAPABILITY_LIMIT", "CONTEXT_DEFECT", "IMPLEMENTATION_DEFECT", "TOOL_FAILURE", "ENVIRONMENT_FAILURE", "TEST_FAILURE", "AMBIGUOUS_REQUIREMENT", "AUTHORIZATION_BLOCKER", "LEAD_DEFECT", null], "description": "required when status is not ok (core §0.12)" },
    "verification_status": { "type": ["string", "null"], "enum": ["ok", "partial", "failed", "none", null], "description": "kept separate from execution status" },
    "final_status": { "type": ["string", "null"], "enum": ["ok", "partial", "failed", null], "description": "the director's adjudication; never inferred from execution alone" },
    "tier": { "type": ["string", "null"], "enum": ["DETERMINISTIC", "FREE-LOCAL", "ECONOMY", "STANDARD", "FRONTIER", null] },
    "runtime": { "type": ["string", "null"], "description": "provider/model runtime id actually used" },
    "task_class": { "type": ["string", "null"] },
    "role": { "type": ["string", "null"], "description": "worker | investigator | reviewer | verifier | interpreter" },
    "governance_version": { "type": ["string", "null"], "description": "e.g. nj-governance-v4" },
    "effort": { "type": ["string", "null"], "enum": ["low", "medium", "high", null] },
    "ownership_scope": { "type": ["array", "null"], "items": { "type": "string" }, "description": "the paths the brief said this worker may write" },
    "start_time": { "type": ["string", "null"], "description": "ISO 8601, from the worker's own clock read" },
    "end_time": { "type": ["string", "null"] },
    "delegations": { "type": ["integer", "null"], "minimum": 0, "description": "workers/agents this worker intentionally spawned or instructed; expected 0" },
    "invalidation_conditions": { "type": ["array", "null"], "items": { "type": "string" }, "description": "what would make this receipt stale" },
    "files": { "type": "array", "items": { "type": "string" } },
    "gates": { "type": "array", "items": { "type": "string" } },
    "artefacts": { "type": "array", "items": { "type": "string" } },
    "leftovers": { "type": "array", "items": { "type": "string" } },
    "detail_path": { "type": "string", "description": "the main deliverable path, or \"none\"; never a separate report file" },
    "words_used": { "type": ["integer", "null"], "minimum": 0, "description": "optional; reports are structured, not word-capped" },
    "tool_calls": { "type": ["integer", "null"], "minimum": 0, "description": "runaway cap counter, not the budget" },
    "usage": {
      "type": "object",
      "description": "per-run measurement; every field nullable, an absent field means NOT MEASURED",
      "properties": {
        "basis": { "type": "string", "enum": ["actual", "estimated"], "description": "estimated and actual are never mixed in one object" },
        "proxy_note": { "type": ["string", "null"], "description": "required when basis=estimated: which proxy was used" },
        "cached_in": { "type": ["integer", "null"], "minimum": 0 },
        "uncached_in": { "type": ["integer", "null"], "minimum": 0 },
        "output": { "type": ["integer", "null"], "minimum": 0 },
        "reasoning": { "type": ["integer", "null"], "minimum": 0 },
        "model_calls": { "type": ["integer", "null"], "minimum": 0 },
        "tool_calls": { "type": ["integer", "null"], "minimum": 0 },
        "files_read": { "type": ["integer", "null"], "minimum": 0 },
        "retries": { "type": ["integer", "null"], "minimum": 0 },
        "escalations": { "type": ["integer", "null"], "minimum": 0 },
        "duration_min": { "type": ["number", "null"], "minimum": 0 },
        "defects_found": { "type": ["integer", "null"], "minimum": 0 },
        "cost": { "type": ["number", "null"], "minimum": 0 },
        "overrun_cause": { "type": ["string", "null"], "enum": ["context-too-wide", "duplicate-reads", "environment-rework", "capability", null] }
      },
      "required": ["basis"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
