#!/bin/sh
# NJ Governance v4 git hook: pre-push (installed by `gov4.py install-repo`).
# Rejects a push that updates refs/heads/main|master or a tag on the remote unless it runs inside a gov4.py
# subprocess (token file named by NJ_GIT_TOKEN in <state>/git-tokens/). Same modes as reference-transaction:
# off = inert, audit = log and allow, enforce = reject. Pure POSIX sh.
# SB-02 / D27: the state path is BAKED IN at install-repo time; no environment variable (NJ_HOME, NJ_MODE_OVERRIDE, HOME) is
# read to find the mode.
NJ_STATE_DIR='@@NJ_STATE_DIR@@'
case "$NJ_STATE_DIR" in '@@'*) NJ_STATE_DIR="$HOME/.claude/nj" ;; esac

nj_mode() {
  m=""
  if [ -f "$NJ_STATE_DIR/mode" ]; then
    m=$(head -n 1 "$NJ_STATE_DIR/mode" 2>/dev/null | tr -d '\r ')
  fi
  case "$m" in off|audit|enforce) ;; *) m=audit ;; esac
  printf '%s' "$m"
}

nj_token_ok() {
  t="${NJ_GIT_TOKEN:-}"
  case "$t" in ""|*[!0-9a-f]*) return 1 ;; esac
  f="$NJ_STATE_DIR/git-tokens/$t"
  [ -f "$f" ] || return 1
  exp=$(head -n 1 "$f" 2>/dev/null | tr -d '\r ')
  case "$exp" in ""|*[!0-9]*) return 1 ;; esac
  [ "$exp" -gt "$(date +%s)" ]
}

mode=$(nj_mode)
if [ "$mode" = "off" ]; then
  cat >/dev/null 2>&1
  exit 0
fi

bad=""
while read -r lref lsha rref rsha; do
  case "$rref" in
    refs/heads/main|refs/heads/master|refs/tags/*|refs/remotes/*) bad="$bad $rref" ;;
  esac
done

[ -n "$bad" ] || exit 0
if nj_token_ok; then
  exit 0
fi

safe=$(printf '%s' "$bad" | tr -d '"\\')
if [ "$mode" = "audit" ]; then
  if [ -d "$NJ_STATE_DIR" ]; then
    printf '{"hook":"pre-push","decision":"would-deny","mode":"audit","refs":"%s","ts":%s}\n' \
      "$safe" "$(date +%s)" >> "$NJ_STATE_DIR/decisions.jsonl" 2>/dev/null
  fi
  exit 0
fi

echo "NJ governance: pushing$bad needs the gov4.py ticket token (use: gov4.py push; mode: $mode)." >&2
exit 1
